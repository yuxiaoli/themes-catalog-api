{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "api_version": {
      "const": "1"
    },
    "available_count": {
      "minimum": 0,
      "type": "integer"
    },
    "category": {
      "enum": [
        "editor",
        "terminal"
      ]
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source_id",
          "format",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "excluded_count": {
      "minimum": 0,
      "type": "integer"
    },
    "names": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "source_count": {
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "const": "partial"
    },
    "popularity": {
      "type": "object",
      "description": "Optional upstream-defined flags within a category. Absent object or flag means unknown; false means evaluated and not in this source's subset. Filter locally.",
      "required": [
        "version",
        "source",
        "catalog_source_revision",
        "ordering",
        "flags",
        "order",
        "unmatched",
        "unavailable"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "repository",
            "revision",
            "path",
            "url",
            "blob_sha",
            "sha256"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "blob_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "catalog_source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "ordering": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unmatched": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "position",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "position",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "api_version",
    "category",
    "status",
    "source_count",
    "available_count",
    "excluded_count",
    "entries",
    "names",
    "excluded"
  ],
  "type": "object"
}
